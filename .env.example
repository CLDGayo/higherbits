# Required for Phase 2 claymorphism-3d-redesign asset generation (Gemini image model).
GEMINI_API_KEY=
# Optional. Overrides the ops asset-gen default image model (gemini-3-pro-image-preview).
# Set to a current image model id if the default is retired (script fails fast on 404/NOT_FOUND).
GEMINI_IMAGE_MODEL=

# --- Payment providers (names only — never commit real values) ---
# Stripe API secret keys. Absent => payments are treated as "not configured"
# (checkout routes return 503; @/lib/stripe throws only on first use).
STRIPE_SECRET_KEY_V1=
STRIPE_SECRET_KEY_V2=
# Stripe webhook signing secrets, one per webhook route version.
STRIPE_WEBHOOK_SECRET_V1=
STRIPE_WEBHOOK_SECRET_V2=
# Lemon Squeezy webhook signing secret (apps/web/app/api/lemonsqueezy/webhook).
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Lemon Squeezy API key, read by configureLemonSqueezy() in apps/web/lib/lemonsqueezy.ts.
LEMON_SQUEEZY_API_KEY=

# --- Analytics ---
# Optional. Google Analytics 4 measurement ID used by apps/web/app/layout.tsx.
# Unset => falls back to the literal G-Z0NZTJ4B1B in source, so analytics keeps working.
# NEXT_PUBLIC_* values are inlined at compile time; changing this requires recompiling.
NEXT_PUBLIC_GA_ID=G-Z0NZTJ4B1B
