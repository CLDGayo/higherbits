{
  "name": "@higherbits-dev/cli",
  "version": "1.0.0",
  "description": "HigherBits MCP server for searching the HigherBits AI component catalogue and retrieving authorized source.",
  "main": "dist/index.js",
  "bin": {
    "higherbits-mcp": "./dist/index.js",
    "higherbits-dev-cli": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CLDGayo/higherbits.git",
    "directory": "packages/ai"
  },
  "homepage": "https://higherbits.dev/magic",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.11.24",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
