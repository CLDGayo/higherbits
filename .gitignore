# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
/.idea

# Video converter folders
video-converter
rename

.next-prod/

# Generated knowledge graph — rebuilt by `graphify update .`, ~1.5k files,
# floods git status and has no review value.
graphify-out/

# Backend bundler output — one timestamped dir per bundle run.
apps/backend/react-bundle-*/

# Agent harness hook logs.
.claude/hooks/.logs/

# One-off debug/probe scripts dropped at the repo root. Root-anchored so real
# source under apps/ and packages/ is never swallowed.
/test-*.js
/sync-*.js
/get-*.js

# Scratch notes and unapplied patches — working files, never committed.
/scratch-*.ts
/scratch-*.tsx
*.patch
